# Copy this file to .env and fill in your token:
#     cp .env.example .env
#
# .env is git-ignored. Never commit it, never paste the token into a chat,
# and never share a screenshot of it.

# Base URL of your Canvas instance (no trailing slash).
CANVAS_API_URL=https://canvas.cornell.edu

# Personal access token.
#   Canvas → profile picture → Account → Settings
#   → Approved Integrations → "+ New Access Token"
# Canvas shows the token exactly once, so copy it immediately.
# Format looks like:  1234~AbCdEf...
CANVAS_API_TOKEN=

# Where the archive is written. Deliberately OUTSIDE this repo so course
# material never ends up in git. ~ is expanded.
ARCHIVE_ROOT=~/canvas-archive

# Concurrent file downloads. Keep this modest to stay well inside Canvas's
# rate limits. Default: 4
CANVAS_DOWNLOAD_WORKERS=4
