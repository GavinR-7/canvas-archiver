# Copy this file to .env and fill it in:
#     cp .env.example .env
#
# .env is git-ignored. Never commit it, never paste credentials into a chat,
# and never share a screenshot of them.

# Base URL of your Canvas instance (no trailing slash).
CANVAS_API_URL=https://canvas.cornell.edu

# How to authenticate. Default: session
#
#   session  Reuse a login from your own browser. Run `canvas-archive login`
#            once; it opens a visible Chromium, you sign in with NetID + Duo
#            yourself, and the resulting Canvas cookies are saved privately.
#            Use this when your institution does not hand out API tokens.
#
#   token    Use a personal access token (below). Cleaner and revocable on its
#            own -- prefer it if you can get one.
CANVAS_AUTH_MODE=session

# Personal access token. Only read when CANVAS_AUTH_MODE=token.
#   Canvas -> profile picture -> Account -> Settings
#   -> Approved Integrations -> "+ New Access Token"
# Canvas shows the token exactly once, so copy it immediately.
# Format looks like:  1234~AbCdEf...
#
# Cornell currently gates these behind an approval request, which is why
# session mode is the default.
CANVAS_API_TOKEN=

# Where the archive is written. Deliberately OUTSIDE this repo so course
# material never ends up in git. ~ is expanded.
ARCHIVE_ROOT=~/canvas-archive

# Concurrent file downloads. Keep this modest to stay well inside Canvas's
# rate limits. Default: 4
CANVAS_DOWNLOAD_WORKERS=4

# Optional. Where saved session cookies and the browser profile live.
# Default: ~/.local/share/canvas-archiver
# CANVAS_ARCHIVER_STATE_DIR=
