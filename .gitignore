# ---- Secrets: must be ignored before .env ever exists ----
.env
.env.*
!.env.example

# ---- Saved browser session: password-equivalent ----
# These normally live in ~/.local/share/canvas-archiver, outside the repo.
# Listed here in case CANVAS_ARCHIVER_STATE_DIR is ever pointed inside it.
cookies.json
browser-profile/

# ---- The archive itself never goes in git ----
canvas-archive/
archive/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
